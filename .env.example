# Sui network: mainnet | testnet | devnet
SUI_NETWORK=mainnet

# Optional: override the official fullnode RPC URL
# SUI_RPC_URL=https://fullnode.mainnet.sui.io:443

# Optional: CoinGecko Demo API key for USD pricing. Pricing works without
# this (CoinGecko's public /simple/price endpoint is unauthenticated), but
# an API key raises your rate limit if you hit it during heavy testing.
# Get one free at https://www.coingecko.com/en/developers/dashboard
# COINGECKO_API_KEY=
